{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(src/content/**)",
      "Write(src/content/**)",
      "Edit(_eleventy_site/**)",
      "Write(_eleventy_site/**)",
      "Edit(public/**)",
      "Write(public/**)",
      "Edit(build/**)",
      "Write(build/**)",
      "Edit(_cache/*.json)",
      "Write(_cache/*.json)",
      "Edit(cv.tex)",
      "Edit(cv-academic.tex)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --amend:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git checkout -- .:*)",
      "Bash(rm -rf:*)",
      "Bash(quarto render:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm run build:all:*)",
      "Bash(npm run render-pdfs:*)",
      "Bash(npm run sync:content:*)"
    ]
  }
}

{
  "name": "adafede-github-io",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal website of Adriano Rutz",
  "author": "Adriano Rutz",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "clean": "node scripts/site/clean.mjs",
    "test": "uv run pytest -q && node --test tests/",
    "build": "npm run build:eleventy",
    "build:all": "npm run render-pdfs && npm run sync:content && npm run build:eleventy",
    "sync:content": "uv run python scripts/site/migrate_posts.py && uv run python scripts/site/optimize_images.py && uv run python scripts/site/build_talkmap.py && uv run python scripts/site/build_expertise.py && node scripts/site/generate-redirects.mjs && node scripts/site/fetch-artwork.mjs && node scripts/site/artwork-size.mjs && node scripts/site/minify-css.mjs && node scripts/site/stage-public.mjs",
    "check": "npm run check:links && npm run check:rdfa && npm run check:document && npm run check:contrast",
    "check:links": "node scripts/site/check-links.mjs _eleventy_site",
    "check:contrast": "node scripts/site/check-contrast.mjs",
    "build:eleventy": "npm run minify:css && npx @11ty/eleventy && node scripts/site/inline-css.mjs",
    "render-pdfs": "node scripts/site/render-pdfs.mjs",
    "minify:css": "node scripts/site/minify-css.mjs",
    "check:rdfa": "node scripts/site/check-rdfa.mjs _eleventy_site",
    "check:a11y": "pa11y-ci --config .pa11yci.json",
    "check:document": "node scripts/site/check-document.mjs _eleventy_site",
    "check:agent-docs": "node scripts/site/check-agent-docs.mjs AGENTS.md",
    "check:agent-endpoints": "node scripts/site/check-agent-endpoints.mjs",
    "check:graph": "node scripts/site/check-graph-age.mjs",
    "graph:update": "graphify update .",
    "lint": "uv run prek run --all-files",
    "check:local-paths": "node scripts/site/check-no-local-paths.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "js-yaml": "^5.5.0",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "pa11y-ci": "^5.0.0",
    "parse5": "^8.0.1",
    "remark": "^15.0.1"
  },
  "dependencies": {
    "speedlify2-score": "^1.1.0"
  }
}

---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in collections.all %}
{% if page.url and not page.data.noindex %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace('.html', '.html') }}</loc>
  </url>
{% endif %}
{% endfor %}
  <url><loc>{{ site.url }}/</loc><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/posts.html</loc><priority>0.9</priority></url>
  {% for post in collections.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ (post.data.updatedDate | default(post.data.pubDate)) | readableDate }}</lastmod>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url><loc>{{ site.url }}/articles.html</loc><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/talks.html</loc><priority>0.7</priority></url>
  <url><loc>{{ site.url }}/teaching.html</loc><priority>0.6</priority></url>
  <url><loc>{{ site.url }}/varia.html</loc><priority>0.5</priority></url>
  <url><loc>{{ site.url }}/cv.html</loc><priority>0.8</priority></url>
</urlset>

{#
  Year-grouped timeline of talks or teaching.

  The caller sets `timelineItems` before including; Nunjucks cannot filter
  inside {% set %}, so the list has to be prepared by the caller or by a
  collection. Both talks.njk and teaching.njk use this.
#}
{% set years = timelineItems | sliceYears %}
{% for year in years %}
<section aria-labelledby="year-{{ year }}" data-filter-group>
  <h2 class="year-heading" id="year-{{ year }}">{{ year }}</h2>
  <ol class="timeline" vocab="https://schema.org/">
    {% for item in timelineItems %}
      {% if item.data.date | year == year %}
      <li typeof="Event" resource="{{ site.url }}{{ item.url }}" data-tags="{{ item | tagKey }}">
        <time property="startDate" datatype="xsd:date" datetime="{{ item.data.date | readableDate }}">{{ item.data.date | monthDay }}</time>
        <div>
          {# Always a link: every entry has its own page. The external event
             URL, when present, is offered there rather than here. #}
          <a class="timeline__title" href="{{ item.url }}" property="url"><span property="name">{{ item.data.title }}</span></a>
          {% if item.data.venue or item.data.location %}<p class="timeline__venue" property="location" typeof="Place"><span property="name">{{ item.data.venue }}{% if item.data.venue and item.data.location %} · {% endif %}{{ item.data.location }}</span></p>{% endif %}
          {% if item.data.authors.length %}<p class="timeline__authors">{% for author in item.data.authors %}{% if loop.index0 > 0 %}, {% endif %}<span property="performer" typeof="Person"{% if author.qid %} about="wd:{{ author.qid }}"{% endif %}><span property="name">{{ author.name }}</span></span>{% endfor %}</p>{% endif %}
          {# The description is Markdown in the source, so it is rendered rather
             than printed; it is also what makes a talk worth clicking into. #}
          {% if item.data.description %}<div class="timeline__summary" property="description">{{ item.data.description | inlineMarkdown | safe }}</div>{% endif %}
        </div>
      </li>
      {% endif %}
    {% endfor %}
  </ol>
</section>
{% endfor %}

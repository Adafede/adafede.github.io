<!doctype html>
<html lang="en" vocab="https://schema.org/" prefix="{{ site.prefixes }}">
  <head>
    <meta charset="UTF-8" />
    {# Paints the right backdrop before the stylesheet is parsed. #}
    <meta name="color-scheme" content="light dark" />
    {# theme-color tints browser chrome (address bar, status bar). It only keys
       off `prefers-color-scheme`, which is the same signal the palette uses, so
       the chrome and the page always agree. The values must stay in step with
       --bg in `:root` and in the dark block of src/styles/global.css; change one
       without the other and the address bar tints the wrong colour. #}
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100f12" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# The analytics script is only discovered when parsing reaches the end of
       the body, so the head is the one place that can prewarm its connection:
       DNS resolves cheaply, and preconnect completes the TCP+TLS handshake in
       parallel with the document rather than after it. #}
    <link rel="preconnect" href="https://scripts.simpleanalyticscdn.com" crossorigin />
    <link rel="dns-prefetch" href="https://scripts.simpleanalyticscdn.com" />
    {# Content Security Policy: the only scripts are SimpleAnalytics (external
       CDN) and the inlined CSS. No inline scripts, no eval, no object/embed.
       connect-src allows SimpleAnalytics' beacon endpoint. #}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'strict-dynamic' 'sha384-yzZn7eUfB4MGWLJ6nlCFRZcvWNWya4kAYI7R7BcN/dXNqrHoUK/IHwn1vzD7ssM/' https://scripts.simpleanalyticscdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.simpleanalytics.com https://scripts.simpleanalyticscdn.com https://*.wikidata.org https://*.wikimedia.org https://*.scholia.wiki https://hypothes.is; base-uri 'self'; form-action 'self'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests" />

    {%- set entry = post or article or talk or course or item %}
    {%- set meta = post and post.data %}
    {%- set effectiveRdfaType = (meta and meta.rdfaType) or rdfaType %}
    {%- set effectiveTitle = title or (entry and entry.data.title) %}
    {%- set pageTitle = (site.author ~ ' — ' ~ effectiveTitle) if (effectiveTitle and effectiveTitle != site.author) else site.author %}
    <title>{{ pageTitle }}</title>
    {%- set rawSummary = description or (article and (article.data.abstract | orDescription(article.data))) or (entry and (entry.data.description or entry.data.venue)) %}
    {%- set summary = (rawSummary | plainText) if entry else rawSummary %}
    {# The canonical URL is this page's own address. Deriving it from `page.url`
       rather than from a front-matter field means every page gets one: a
       canonical link that is present on some pages and absent on others is
       worse than none, because it makes the omissions look deliberate. #}
    {% set canonicalUrl = site.url + (page.url | replace('index.html', '')) %}
    {% if summary %}<meta name="description" content="{{ summary }}" />{% endif %}
    <link rel="canonical" href="{{ canonicalUrl }}" />

    <meta name="author" content="{{ site.author }}" />
    {# Not a version pin: `eleventy.generator` is not exposed to templates, so
       this used to render as a bare "Eleventy ". #}
    <meta name="generator" content="Eleventy" />

    <meta property="og:type" content="{% if effectiveRdfaType %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site.author }}" />
    <meta property="og:locale" content="en" />
    {# The full title, not the bare page title. A link preview stands alone in
       a feed: "Swiss pharmaceutical scientist" with no name on it reads as a
       page about an unnamed person. #}
    <meta property="og:title" content="{{ pageTitle }}" />
    {% if summary %}<meta property="og:description" content="{{ summary }}" />{% endif %}
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
    <meta property="og:image:alt" content="{{ site.author }}" />
    {% if meta and meta.pubDate %}<meta property="article:published_time" content="{{ meta.pubDate | isoDate }}" />{% endif %}
    {% if meta and meta.updatedDate %}<meta property="article:modified_time" content="{{ meta.updatedDate | isoDate }}" />{% endif %}

    {# Twitter/X reads the og:* tags, but only if told to; without this the card
       renders as a bare link. #}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    {% if summary %}<meta name="twitter:description" content="{{ summary }}" />{% endif %}
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />

    {% if effectiveRdfaType %}<meta property="schema:type" content="{{ effectiveRdfaType }}" />{% endif %}
    {% if meta and meta.authors %}{% for author in meta.authors %}<meta name="citation_author" content="{{ author.name }}" />{% endfor %}{% endif %}
    {% if meta and meta.pubDate %}<meta name="citation_publication_date" content="{{ meta.pubDate | readableDate }}" />{% endif %}
    {% if meta and meta.doi %}<meta name="citation_doi" content="{{ meta.doi }}" />{% endif %}
    {% if meta and meta.license and meta.license.url %}<link rel="license" href="{{ meta.license.url }}" />{% endif %}
    {% if meta and meta.tags %}<meta name="keywords" content="{{ meta.tags | join(', ') }}" />{% endif %}

    <link rel="alternate" type="application/rss+xml" title="{{ site.author }} — All items" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.author }} — Posts" href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.author }} — Posts" href="/posts.json" />
    {# One feed per listing, as Quarto published. Declared here so a reader
       arriving at any page can subscribe to the section they are reading
       without first finding its feed URL. #}
    {%- for feed in listingFeeds %}
    {%- if feed.slug != 'rss' %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.author }} — {{ feed.title }}" href="/{{ feed.slug }}.xml" />
    {%- endif %}
    {%- endfor %}
    {# Declared, not merely published: a sitemap nobody links to is a sitemap
       nobody finds. #}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {# Lighthouse Agentic Browsing discovers the catalog via this relation
       before falling back to /.well-known/ai-catalog.json. #}
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/ai-catalog+json" />
    <link rel="icon" href="/images/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {%- if page.url == '/' %}
    <link rel="preload" as="image" type="image/avif" imagesrcset="/images/profile/avatar-150.avif 160w, /images/profile/avatar-260.avif 290w, /images/profile/avatar-520.avif 520w" imagesizes="(max-width: 48rem) 5.5rem, 9rem" fetchpriority="high" />
    {%- endif %}
    <link rel="stylesheet" href="/styles.css">
  </head>

  {# `is-home` lets the stylesheet drop the header wordmark on the home page,
     where the hero already carries the name in full size. #}
  <body{% if page.url == '/' %} class="is-home"{% endif %}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header" typeof="WPHeader">
      <nav class="site-header__inner" aria-label="Main" typeof="SiteNavigationElement">
        <a class="site-header__brand" href="/" rel="home" property="name">{{ site.author }}</a>
        <ul class="site-nav">
          {% for item in site.nav %}
          <li>
            {# Section match, not exact URL: every article, talk, course and
               varia entry lives under its listing's prefix, so exact equality
               left all detail pages with no active item at all. #}
            {% set section = item.url | replace('.html', '') %}
            <a href="{{ item.url }}" {% if page.url == item.url or page.url.startsWith(section + '/') %}aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
          {% endfor %}
        </ul>
        <div class="site-header__controls">
        {# No theme control. The palette follows the operating system, which is
           the one thing a page can read without script — so there is nothing to
           remember and no flash when a reader follows a link. An explicit toggle
           cannot survive navigation without storage, and a choice that snaps
           back on every click is worse than no choice. #}
        <ul class="site-nav site-nav--utility">
          <li>
            <a href="/rss.xml" title="RSS feed" aria-label="RSS feed">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/adafede/adafede.github.io" rel="me noopener" title="Source on GitHub" aria-label="Source on GitHub">
              <svg class="icon" viewBox="0 0 78 78" fill="currentColor" aria-hidden="true" focusable="false"><path transform="translate(10 10) rotate(-45 29 29)" d="M5 58c-2.76 0-5-2.24-5-5V5c0-2.76 2.24-5 5-5h33v12.54c-2.07.95-3.5 3.03-3.5 5.46 0 .74.13 1.44.37 2.09L19.59 35.37a5.9 5.9 0 0 0-2.09-.37 6 6 0 1 0 6 6c0-.74-.13-1.44-.37-2.09l14.87-14.87v11.5a6 6 0 1 0 5 0V23.46a6 6 0 0 0 0-10.92V0h10c2.76 0 5 2.24 5 5v48c0 2.76-2.24 5-5 5z"/></svg>
            </a>
          </li>
        </ul>
        </div>
      </nav>
    </header>

    <main class="site-main" id="main" tabindex="-1">
      {{ content | safe }}
    </main>

    <footer class="site-footer" typeof="WPFooter">
      <a class="analytics-badge" href="https://www.simpleanalytics.com?utm_source=adafede.github.io&utm_content=badge" referrerpolicy="origin" target="_blank" rel="noopener noreferrer">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="13" width="3.2" height="7" rx="1" fill="currentColor"/><rect x="10.4" y="8.5" width="3.2" height="11.5" rx="1" fill="currentColor"/><rect x="16.8" y="4" width="3.2" height="16" rx="1" fill="currentColor"/></svg>
        Simple Analytics
      </a>
      <a class="site-footer__link" href="/privacy.html" rel="privacy-policy">Privacy</a>
    </footer>

    {# SimpleAnalytics — the only script on the site. External links are
       handled at build time by an Eleventy transform that adds
       target="_blank" rel="noopener noreferrer" and rel="noopener noreferrer" — see the comment on
       externalLinks in eleventy.config.mjs. Its SRI hash is hard-coded because
       it is fetched from a versionless URL with no local file to derive it. #}
    <script async defer src="https://scripts.simpleanalyticscdn.com/latest.js" crossorigin="anonymous" integrity="sha384-yzZn7eUfB4MGWLJ6nlCFRZcvWNWya4kAYI7R7BcN/dXNqrHoUK/IHwn1vzD7ssM/"></script>
  </body>
</html>

{#
  Topic filter for a listing. `items` must be the collection being listed, so the
  counts match what is on the page.

  Multi-select: zero or more tags can be checked at once. Checking a tag shows
  the union of all entries that carry any checked tag. The "All" checkbox clears
  every other tag.

  How it works:

    * Checkboxes (not radios) so several can be on.
    * A small inline script reads the checked tags and sets `data-hidden` on
      entries that match none of them, and `data-group-hidden` on
      `[data-filter-group]` sections left empty. This is what makes the union
      possible: CSS alone can only express "does not match THIS one tag", which
      without enumeration is an intersection, not a union.
    * The per-tag `:has(#tag-N:checked)` rules below are the no-JS fallback:
      each checked box hides its non-matches, and with several checked the
      result is an intersection. That is a reasonable degradation and still
      narrows the list.
    * The same `:has()` rules drive the selected/focus state of each pill in
      both the JS and no-JS paths, so the visible feedback is identical.
#}
{% set counts = items | tagCounts %}
{% if counts.length %}
<div class="tag-filter" data-filter-root>
  <h2 class="tag-filter__heading" id="filter-heading">Filter by topic</h2>

  {# A real <fieldset>, not a div with role="group": these are checkboxes,
     and the native grouping element gives them an accessible name without an
     aria-label bolted on. WAVE flags a bare group.
     The wrapping form is a WebMCP tool: an agent checks one or more topic
     checkboxes and the existing CSS + JS hide non-matching entries. #}
  <form class="tag-filter__form" toolname="filter_by_topic" tooldescription="Filter this listing to entries tagged with one or more topics. Checking a tag shows entries that carry any checked tag; clearing all tags shows every entry. Filtering is client-side; nothing is submitted to a server." onsubmit="return false">
  <fieldset class="tag-filter__inputs">
    <legend class="visually-hidden">Filter by topic</legend>
    <input type="checkbox" name="topic" id="tag-all" value="all" toolparamdescription="Show every entry. Use all to clear the filter." checked>
    {% for entry in counts %}
    <input type="checkbox" name="topic" id="tag-{{ loop.index }}" value="{{ entry.tag | lower }}" toolparamdescription="Topic slug to match. Check to keep entries carrying this tag visible.">
    {% endfor %}
  </fieldset>
  {# Pa11y requires a submit control on every form. Filtering is CSS/JS-only;
     submit is a no-op (`onsubmit="return false"`). #}
  <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Apply topic filter</button>
  </form>

  <ul class="tag-filter__list">
    <li><label class="tag" for="tag-all">All <span class="tag-filter__count">{{ items | length }}</span></label></li>
    {% for entry in counts %}
    <li><label class="tag" for="tag-{{ loop.index }}">{{ entry.tag }} <span class="tag-filter__count">{{ entry.count }}</span></label></li>
    {% endfor %}
  </ul>

  {# Selected + focus state for each pill, and the no-JS hide rules. These are
     per-tag so the `:has()` selector knows which checkbox to observe. With the
     script active the hide rules are overridden by `data-hidden`, but the
     selected/focus styling stays in sync either way. #}
  <style>
    /* "All" starts checked, so it has to look selected from the start. */
    .tag-filter:has(#tag-all:checked) label[for="tag-all"] {
      background: var(--brand);
      border-color: var(--brand);
      color: var(--brand-ink);
    }
    {% for entry in counts %}
    /* No-JS fallback: hide entries that do not carry this tag. With several
       tags checked the survivors match all of them (intersection), which is
       the best a static selector can do without enumerating subsets. The JS
       above replaces this with union semantics. Disabled when JS sets
       data-filter-active, so CSS and JS do not fight over visibility. */
    .site-main:not([data-filter-active]):has(#tag-{{ loop.index }}:checked) [data-tags]:not([data-tags*="|{{ entry.tag | lower }}|"]) { display: none; }
    .site-main:not([data-filter-active]):has(#tag-{{ loop.index }}:checked) [data-filter-group]:not(:has([data-tags*="|{{ entry.tag | lower }}|"])) { display: none; }
    /* Selected pill */
    .tag-filter:has(#tag-{{ loop.index }}:checked) label[for="tag-{{ loop.index }}"] {
      background: var(--brand);
      border-color: var(--brand);
      color: var(--brand-ink);
    }
    /* Focus ring on the hidden checkbox lands on its label */
    .tag-filter:has(#tag-{{ loop.index }}:focus-visible) label[for="tag-{{ loop.index }}"] {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
    {% endfor %}
    .tag-filter:has(#tag-all:focus-visible) label[for="tag-all"] {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
  </style>
</div>

<script>
  (function () {
    var root = document.currentScript.closest('[data-filter-root]');
    if (!root) return;

    var scope = document.querySelector('.site-main') || root.parentNode;
    var checkboxes = root.querySelectorAll('input[type="checkbox"][name="topic"]');
    var allCheckbox = root.querySelector('#tag-all');
    var entries = scope.querySelectorAll('[data-tags]');
    var groups = scope.querySelectorAll('[data-filter-group]');

    function checkedTags() {
      var tags = [];
      checkboxes.forEach(function (cb) {
        if (cb === allCheckbox) return;
        if (cb.checked) tags.push(cb.value);
      });
      return tags;
    }

    function apply() {
      var tags = checkedTags();
      var anyChecked = tags.length > 0;

      if (anyChecked) {
        scope.setAttribute('data-filter-active', 'true');
        allCheckbox.checked = false;
      } else {
        scope.removeAttribute('data-filter-active');
      }

      entries.forEach(function (entry) {
        if (!anyChecked) {
          entry.removeAttribute('data-hidden');
        } else {
          var ds = entry.getAttribute('data-tags') || '';
          var visible = tags.some(function (t) {
            return ds.indexOf('|' + t + '|') !== -1;
          });
          if (visible) entry.removeAttribute('data-hidden');
          else entry.setAttribute('data-hidden', '');
        }
      });

      groups.forEach(function (group) {
        if (!anyChecked) {
          group.removeAttribute('data-group-hidden');
          return;
        }
        var visible = group.querySelectorAll('[data-tags]:not([data-hidden])');
        if (visible.length === 0) group.setAttribute('data-group-hidden', '');
        else group.removeAttribute('data-group-hidden');
      });
    }

    // "All" clears every other checkbox and shows everything.
    allCheckbox.addEventListener('change', function () {
      if (allCheckbox.checked) {
        checkboxes.forEach(function (cb) {
          if (cb !== allCheckbox) cb.checked = false;
        });
        apply();
      }
    });

    // Any topic checkbox clears "All" and re-applies.
    checkboxes.forEach(function (cb) {
      if (cb === allCheckbox) return;
      cb.addEventListener('change', function () {
        if (cb.checked && allCheckbox.checked) allCheckbox.checked = false;
        apply();
      });
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', apply);
    } else {
      apply();
    }
  })();
</script>
{% endif %}

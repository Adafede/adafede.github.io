{#
  Topic filter for a listing. `items` must be the collection being listed, so the
  counts match what is on the page.

  Multi-select: zero or more tags can be checked at once. A pure-CSS approach
  using `:has(:checked)` hides entries that do not carry each checked tag.

  Semantics: with pure CSS, multiple checked tags narrow the list by
  intersection (AND) — an entry must carry ALL checked tags to remain visible.
  This is a deliberate trade-off: CSS has no way to express "show entries
  matching ANY of the checked tags" (union/OR) without JavaScript, because
  `display: none` is additive — each checked box can only hide non-matches,
  and stacking several hide-rules only ever removes more entries. The original
  single-select variant documented this explicitly.

  The "All" checkbox is checked by default and, being a checkbox rather than a
  radio, does not prevent others from being checked. When every topic box is
  unchecked, "All" appears checked and the full list is shown.
#}
{% set counts = items | tagCounts %}
{% if counts.length %}
<div class="tag-filter" data-filter-root>
  <h2 class="tag-filter__heading" id="filter-heading">Filter by topic</h2>

  {# A real <fieldset>, not a div with role="group": these are checkboxes,
     and the native grouping element gives them an accessible name without an
     aria-label bolted on. WAVE flags a bare group. #}
  <form class="tag-filter__form" onsubmit="return false">
  <fieldset class="tag-filter__inputs">
    <legend class="visually-hidden">Filter by topic</legend>
    <input type="checkbox" name="topic" id="tag-all" value="all" checked>
    {% for entry in counts %}
    <input type="checkbox" name="topic" id="tag-{{ loop.index }}" value="{{ entry.tag | lower }}">
    {% endfor %}
  </fieldset>
  {# Pa11y requires a submit control on every form. Filtering is CSS-only;
     submit is a no-op (`onsubmit="return false"`). #}
  <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Apply topic filter</button>
  </form>

  <ul class="tag-filter__list">
    <li><label class="tag" for="tag-all">All <span class="tag-filter__count">{{ items | length }}</span></label></li>
    {% for entry in counts %}
    <li><label class="tag" for="tag-{{ loop.index }}">{{ entry.tag }} <span class="tag-filter__count">{{ entry.count }}</span></label></li>
    {% endfor %}
  </ul>

  {# Selected + focus state and no-JS hide rules. Per-tag so the `:has()`
     selector knows which checkbox to observe. With several tags checked the
     survivors carry all of them (intersection), which is the best a static
     selector can do without JavaScript. #}
  <style>
    /* "All" starts checked, so it has to look selected from the start. */
    .tag-filter:has(#tag-all:checked) label[for="tag-all"] {
      background: var(--brand);
      border-color: var(--brand);
      color: var(--brand-ink);
    }
    {% for entry in counts %}
    /* No-JS hide: entries without this tag are hidden when its box is checked.
       Scoped to .site-main (which holds both the filter and the entries as
       siblings), not .tag-filter (which only contains the controls). Stacking
       several checked boxes narrows to the intersection of their tags. */
    .site-main:has(#tag-{{ loop.index }}:checked) [data-tags]:not([data-tags*="|{{ entry.tag | lower }}|"]) { display: none; }
    .site-main:has(#tag-{{ loop.index }}:checked) [data-filter-group]:not(:has([data-tags*="|{{ entry.tag | lower }}|"])) { display: none; }
    /* Selected pill */
    .tag-filter:has(#tag-{{ loop.index }}:checked) label[for="tag-{{ loop.index }}"] {
      background: var(--brand);
      border-color: var(--brand);
      color: var(--brand-ink);
    }
    /* Focus ring on the hidden checkbox lands on its label */
    .tag-filter:has(#tag-{{ loop.index }}:focus-visible) label[for="tag-{{ loop.index }}"] {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
    {% endfor %}
    .tag-filter:has(#tag-all:focus-visible) label[for="tag-all"] {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
  </style>
</div>

  {# Read topic= query parameters from the URL and check the matching
     checkboxes on load, and write checkbox state back to the URL on change.
     The CSS :has(:checked) rules do the actual hiding — this script only
     syncs checkbox state with the URL, so a filtered view can be bookmarked
     or shared. Skipped if scripting is disabled; the filter still works live
     via CSS. URL format: ?topic=tag1&topic=tag2 (multiple params). #}
  <script>
    (function () {
      var root = document.querySelector('[data-filter-root]');
      if (!root) return;
      var all = root.querySelector('#tag-all');
      var checkboxes = root.querySelectorAll('input[type="checkbox"][name="topic"]');

      function readCheckedTags() {
        var tags = [];
        checkboxes.forEach(function (cb) {
          if (cb === all) return;
          if (cb.checked) tags.push(cb.value);
        });
        return tags;
      }

      function updateUrl(tags) {
        var url = new URL(window.location);
        url.search = '';
        tags.forEach(function (t) {
          url.searchParams.append('topic', t);
        });
        // pushState (not replaceState) so the back button can undo filter
        // changes one step at a time. When no tags are selected, strip the
        // query string entirely so the URL is clean when showing all entries.
        if (tags.length) {
          window.history.pushState(null, '', url);
        } else {
          window.history.pushState(null, '', url.pathname + url.hash);
        }
      }

      function syncFromUrl() {
        var params = new URLSearchParams(window.location.search);
        var topics = params.getAll('topic').map(function (t) { return t.toLowerCase(); });
        topics = topics.filter(function (t) { return t !== 'all'; });
        if (!topics.length) return;
        // Uncheck "All" so topic pills look unselected when topics come from URL.
        if (all) all.checked = false;
        topics.forEach(function (t) {
          var cb = root.querySelector('input[type="checkbox"][name="topic"][value="' + t + '"]');
          if (cb) cb.checked = true;
        });
      }

      // "All" clears every other checkbox and resets the URL.
      if (all) {
        all.addEventListener('change', function () {
          if (all.checked) {
            checkboxes.forEach(function (cb) {
              if (cb !== all) cb.checked = false;
            });
            updateUrl([]);
          }
        });
      }

      // Any topic checkbox clears "All" and updates the URL.
      checkboxes.forEach(function (cb) {
        if (cb === all) return;
        cb.addEventListener('change', function () {
          if (cb.checked && all && all.checked) all.checked = false;
          updateUrl(readCheckedTags());
        });
      });

      syncFromUrl();
    })();
  </script>
{% endif %}

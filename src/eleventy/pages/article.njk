---
layout: base.njk
pagination:
  data: collections.articles
  size: 1
  alias: article
permalink: "/articles/{{ article.id }}.html"
eleventyExcludeFromCollections: true
rdfaType: ScholarlyArticle
---
{% set groupLabels = { first: 'Single first author', shared: 'Shared first author', co: 'Co-author', thesis: 'Doctoral thesis' } %}
{# `article.data.group` is the authorship bucket; deriving it here rather than
   reading a bare `group` is what the breadcrumb used to do, and `group` is not
   in scope on this page, so the label rendered as an empty element. #}
{% set authorship = groupLabels[article.data.group] or 'Article' %}
{# The nav is both a link trail and a BreadcrumbList. A search engine reads the
   second to understand where a page sits in the site; a screen reader reads the
   first. Same markup, two consumers. #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb__list" vocab="https://schema.org/" typeof="BreadcrumbList">
    <li property="itemListElement" typeof="ListItem">
      <a property="item" href="/articles.html" typeof="WebPage"><span property="name">Articles</span></a>
      <meta property="position" content="1" />
    </li>
    <li><span aria-hidden="true">/</span></li>
    <li property="itemListElement" typeof="ListItem">
      <span property="item" typeof="WebPage" resource="{{ site.url }}{{ page.url }}"><span property="name">{{ authorship }}</span></span>
      <meta property="position" content="2" />
    </li>
  </ol>
</nav>

<article class="article" vocab="https://schema.org/" typeof="ScholarlyArticle"
  resource="{{ site.url }}{{ page.url }}"
  {% if article.data.qid %}about="wd:{{ article.data.qid }}"{% endif %}>
  <header class="article__header">
    <h1 property="name">{{ article.data.title }}</h1>
    <p class="article__meta">
      {% if article.data.venue %}<span class="article__venue" typeof="Periodical" property="isPartOf"><span property="name">{{ article.data.venue }}</span></span><span aria-hidden="true"> · </span>{% endif %}
      <time property="datePublished" datatype="xsd:date" datetime="{{ article.data.date | readableDate }}">{{ article.data.date | readableDate }}</time>
    </p>

    {# The artwork, at full resolution. The listing card shows a preview; this
       is the page a reader came for, so it gets the file itself — vector if it
       arrived as one, never a raster stand-in. #}
    {% if article.data.image %}
    {% set artwork = article.data.image | artwork %}
    {% set artworkSize = artwork | artworkSize %}
    <figure class="article__figure">
      <img class="article__image" property="image" src="{{ artwork }}" alt="{{ article.data.imageAlt or '' }}" fetchpriority="high" decoding="async"
        width="{{ artworkSize.width }}" height="{{ artworkSize.height }}" />
    </figure>
    {% endif %}

    {% authorList article.data.authors, "article" %}
  </header>

  {% if article.data.abstract %}
  <section class="article__section" aria-labelledby="abstract-heading">
    <h2 class="article__subheading" id="abstract-heading">Abstract</h2>
    <div class="article__abstract prose" property="abstract">{{ article.data.abstract | inlineMarkdown | safe }}</div>
  </section>
  {% endif %}

  <div class="prose article__body">{{ article.body | renderMarkdown(article.data) | safe }}</div>

  <footer class="article__footer">
    <p class="article__links">
      {# Icon and value, no registry name: the icon says which registry it is,
         the text says which record, and spelling out "DOI" on a link that
         already carries the DOI icon just repeats it. #}
      {% if article.data.doi %}<a rel="sameAs" property="identifier" href="https://doi.org/{{ article.data.doi }}" title="DOI {{ article.data.doi }}">{% registryIcon 'doi' %}<span class="identifier">{{ article.data.doi }}</span></a>{% endif %}
      {% if article.data.qid %}<a rel="sameAs" href="https://qlever.scholia.wiki/work/{{ article.data.qid }}" title="Scholia {{ article.data.qid }}">{% registryIcon 'scholia' %}<span class="identifier">{{ article.data.qid }}</span></a>{% endif %}
      {% if article.data.venue %}<span>{{ article.data.venue }}</span>{% endif %}
    </p>
    {% if article.data.tags.length %}
    <ul class="tag-list" property="keywords" aria-label="Tags">
      {% for tag in article.data.tags %}<li><span class="tag">{{ tag }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </footer>
</article>

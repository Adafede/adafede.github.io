---
layout: base.njk
pagination:
  data: collections.talks
  size: 1
  alias: talk
permalink: "/talks/{{ talk.id }}.html"
eleventyExcludeFromCollections: true
---
<article class="event-detail" vocab="https://schema.org/" typeof="Event" resource="{{ site.url }}{{ page.url }}">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list" vocab="https://schema.org/" typeof="BreadcrumbList">
      <li property="itemListElement" typeof="ListItem">
        <a property="item" href="/talks.html" typeof="WebPage"><span property="name">Talks</span></a>
        <meta property="position" content="1" />
      </li>
      <li><span aria-hidden="true">/</span></li>
      <li property="itemListElement" typeof="ListItem">
        <span property="item" typeof="WebPage" resource="{{ site.url }}{{ page.url }}"><span property="name">{{ talk.data.title }}</span></span>
        <meta property="position" content="2" />
      </li>
    </ol>
  </nav>

  <header class="event-detail__header">
    <h1 property="name">{{ talk.data.title }}</h1>

    {# Authors, their ORCID and their Wikidata item, then their affiliations —
       the same order and the same registry links as the article and post pages.
     Affiliations are read per author, so a co-presented talk does not read as a
     list of institutions belonging to whoever happens to be named first. #}
    {% authorList talk.data.authors, "performer" %}

    <p class="event-detail__meta">
      {% if talk.data.date %}<time property="startDate" datatype="xsd:date" datetime="{{ talk.data.date | readableDate }}">{{ talk.data.date | readableDate }}</time>{% endif %}
      {% if talk.data.venue %} · <span class="event-detail__venue" property="superEvent" typeof="Event"><span property="name">{{ talk.data.venue }}</span></span>{% endif %}
      {% if talk.data.location %} · <span property="location" typeof="Place"><span property="name">{{ talk.data.location }}</span></span>{% endif %}
    </p>
    {% if talk.data.tags.length %}
    <ul class="tag-list" property="keywords" aria-label="Tags">
      {% for tag in talk.data.tags %}<li><span class="tag">{{ tag }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </header>

  {% if talk.data.description %}<div class="event-detail__summary prose" property="description">{{ talk.data.description | inlineMarkdown | safe }}</div>{% endif %}

  {% if talk.body %}
  <div class="prose">{{ talk.body | renderMarkdown(talk.data) | safe }}</div>
  {% endif %}

  <p class="event-detail__links">
    {% if talk.data.url %}<a class="button" href="{{ talk.data.url }}" rel="sameAs noopener">Event page</a>{% endif %}
    <a href="/talks.html">All talks</a>
  </p>
</article>

---
layout: base.njk
title: Varia
description: "Projects, tools, datasets and assorted resources."
permalink: /varia.html
---
<div class="page-header">
  <h1>Varia</h1>
  <p class="page-header__lede">Tools, datasets and side projects that do not fit anywhere else.</p>

{% set items = varia %}
{% include 'tag-filter.njk' %}

{% for group in varia | groupByVaria %}
<section class="listing-section" data-filter-group aria-labelledby="varia-{{ group.id }}">
  <h2 id="varia-{{ group.id }}">{{ group.label }} <span class="listing-section__count">{{ group.items.length }}</span></h2>
  <ul class="entry-list entry-list--grid">
    {% for card in group.items %}
    <li class="entry{% if card.data.image %} entry--with-image{% endif %}" data-tags="{{ card | tagKey }}">
      {% if card.data.image %}
      {% set artworkSize = card.data.image | artwork | artworkSize %}
      {# The frame is a wrapper, not the <img>, so the artwork can be sized to
         its own shape inside a frame of consistent size. Putting the frame on
         the image means the image fills the frame, and an artwork that is not
         the frame's shape has to be letterboxed into it — which is what made
         the square and tall logos read as images that failed to load. #}
      <div class="entry__media">
        <img class="entry__image" src="{{ card.data.image | artwork }}" loading="lazy" decoding="async" fetchpriority="low"
          width="{{ artworkSize.width }}" height="{{ artworkSize.height }}"
          {% if card.data.imageAlt %}alt="{{ card.data.imageAlt }}"{% else %}alt=""{% endif %} />
      </div>
      {% endif %}
      <h3 class="entry__title"><a href="{{ card.url }}">{{ card.data.title }}</a></h3>
      {# Many entries carry only their URL as the description; printing it
         again just repeats the link below. #}
      {% if card.data.description and card.data.description != card.data.url %}<p class="entry__summary">{{ card.data.description }}</p>{% endif %}
      {% if card.data.tags.length %}
      <ul class="tag-list" aria-label="Tags for {{ card.data.title }}">
        {% for tag in card.data.tags %}<li><span class="tag">{{ tag }}</span></li>{% endfor %}
      </ul>
      {% endif %}
      {% if card.data.url %}<p class="entry__meta"><a href="{{ card.data.url }}" rel="noopener">Visit ↗</a></p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

---
layout: base.njk
title: Posts
description: Blog posts and long-form notes on open chemistry, metabolomics, Wikidata and cheminformatics.
permalink: /posts.html
---
<div class="page-header">
  <h1>Posts</h1>
  <p class="page-header__lede">{{ collections.posts.length }} post{{ '' if collections.posts.length == 1 else 's' }} on open chemistry, metabolomics, Wikidata and the infrastructure around them. Newest first.</p>

{% set items = collections.posts %}
{% include 'tag-filter.njk' %}

<ul class="entry-list" vocab="https://schema.org/" typeof="Blog">
  {% for post in collections.posts %}
  <li class="entry" property="blogPost" typeof="BlogPosting" data-tags="{{ post | tagKey }}">
    <h2 class="entry__title"><a rel="item" property="url" href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="entry__meta">
      <time property="datePublished" datetime="{{ post.data.pubDate | readableDate }}">{{ post.data.pubDate | readableDate }}</time>
      {% if post.data.doi %} · <a rel="sameAs" href="https://doi.org/{{ post.data.doi }}">{{ post.data.doi }}</a>{% endif %}
      {% if post.data.pdf %} · <a href="{{ post.data.pdf }}" target="_blank" rel="noopener" type="application/pdf" title="PDF of {{ post.data.title }}">{% registryIcon 'pdf' %}PDF<span class="visually-hidden"> of {{ post.data.title }} (opens in a new tab)</span></a>{% endif %}
      {% if post.data.authors.length %} · <span property="author">{{ post.data.authors | joinNames }}</span>{% endif %}
    </p>
    {% if post.data.description %}<p class="entry__summary">{{ post.data.description }}</p>{% endif %}
    {% if post.data.tags.length %}
    <ul class="tag-list" property="keywords" aria-label="Tags for {{ post.data.title }}">
      {% for tag in post.data.tags %}<li><span class="tag">{{ tag }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </li>
  {% endfor %}
</ul>

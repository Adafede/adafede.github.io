---
layout: base.njk
pagination:
  data: collections.variaItems
  size: 1
  alias: item
permalink: "/varia/{{ item.id }}.html"
eleventyExcludeFromCollections: true
---
<article class="event-detail" vocab="https://schema.org/" typeof="CreativeWork" resource="{{ site.url }}{{ page.url }}">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list" vocab="https://schema.org/" typeof="BreadcrumbList">
      <li property="itemListElement" typeof="ListItem">
        <a property="item" href="/varia.html" typeof="WebPage"><span property="name">Varia</span></a>
        <meta property="position" content="1" />
      </li>
      <li><span aria-hidden="true">/</span></li>
      <li property="itemListElement" typeof="ListItem">
        <span property="item" typeof="WebPage" resource="{{ site.url }}{{ page.url }}"><span property="name">{{ item.data.title }}</span></span>
        <meta property="position" content="2" />
      </li>
    </ol>
  </nav>

  <header class="event-detail__header">
    {% if item.data.image %}
    {% set artwork = item.data.image | artwork %}
    {% set artworkSize = artwork | artworkSize %}
    <img class="event-detail__image" property="image" src="{{ artwork }}" loading="eager" decoding="async" fetchpriority="high" width="{{ artworkSize.width }}" height="{{ artworkSize.height }}"
      {% if item.data.imageAlt %}alt="{{ item.data.imageAlt }}"{% else %}alt=""{% endif %} />
    {% endif %}
    <h1 property="name">{{ item.data.title }}</h1>
    {% if item.data.tags.length %}
    <ul class="tag-list" property="keywords" aria-label="Tags">
      {% for tag in item.data.tags %}<li><span class="tag">{{ tag }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </header>

  {% if item.body %}
  <div class="prose" property="description">{{ item.body | renderMarkdown(item.data) | safe }}</div>
  {% elif item.data.description and item.data.description != item.data.url %}
  {# Some entries are a bare pointer; do not render a URL as the body. #}
  <div class="event-detail__summary prose" property="description">{{ item.data.description | inlineMarkdown | safe }}</div>
  {% endif %}

  <p class="event-detail__links">
    {% if item.data.url %}<a class="button" href="{{ item.data.url }}" rel="sameAs noopener" target="_blank">Visit<span class="visually-hidden"> {{ item.data.title }}</span></a>{% endif %}
    <a href="/varia.html">All varia</a>
  </p>
</article>

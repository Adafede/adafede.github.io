---
layout: base.njk
title: Articles
description: "Peer-reviewed articles: single first author, shared first author, co-author, and doctoral thesis."
permalink: /articles.html
---
{# The Google Scholar URL has a query string, which Nunjucks reads as a ternary
   operator, so site.js assembles it as site.scholarUrl. #}
{% set groups = collections.articleGroups %}

<div class="page-header">
  <h1>Articles</h1>
  <p class="page-header__lede">
    Peer-reviewed work, grouped by authorship and ordered by date. Every entry links to its
    DOI and to the Wikidata item that powers the interactive views.
  </p>

{% if profiles.qid or profiles.orcid or profiles.scholar %}
<section class="profiles" aria-labelledby="profiles-heading">
  <h2 id="profiles-heading" class="sr-heading">Publication profiles</h2>
  <ul class="profiles__list">
    {% if profiles.qid %}
    <li><strong>{% registryIcon 'scholia' %}Scholia</strong> <a href="https://qlever.scholia.wiki/author/{{ profiles.qid }}" rel="noopener">{{ profiles.qid }}</a></li>
    {% endif %}
    {% if profiles.orcid %}
    <li><strong>{% registryIcon 'orcid' %}ORCID</strong> <a href="https://orcid.org/{{ profiles.orcid }}" rel="noopener">{{ profiles.orcid }}</a></li>
    {% endif %}
    {% if profiles.scholar %}
    <li><strong>{% registryIcon 'scholar' %}Google Scholar</strong> <a href="{{ site.scholarUrl }}" rel="noopener">{{ profiles.scholar }}</a></li>
    {% endif %}
  </ul>
</section>
{% endif %}

  {% set items = collections.articles %}
  {% include 'tag-filter.njk' %}

  {% for group in groups %}
  {% if group.items.length %}
  <section class="listing-section" data-filter-group aria-labelledby="{{ group.key }}-heading">
    <h2 id="{{ group.key }}-heading">
      {{ group.label }}
      <span class="listing-section__count">{{ group.items.length }}</span>
    </h2>

    {# Single- and shared-first-author papers get the full card, with cover art.
       The co-author list is long enough that a table reads better. #}
    {% if group.table %}
    <div class="table-scroll">
      <table class="publication-table">
        <caption class="visually-hidden">{{ group.label }}</caption>
        <thead><tr><th scope="col">Date</th><th scope="col">Title</th><th scope="col">Venue</th></tr></thead>
        <tbody>
          {% for article in group.items %}
          <tr data-tags="{{ article | tagKey }}">
            <td><time datetime="{{ article.data.date | readableDate }}">{{ article.data.date | readableDate }}</time></td>
            <td><a href="{{ article.url }}">{{ article.data.title }}</a></td>
            <td>{{ article.data.venue }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="publication-list">
      {% for article in group.items %}{% include 'publication-card.njk' %}{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}
  {% endfor %}

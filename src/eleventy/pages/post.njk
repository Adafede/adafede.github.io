---
layout: base.njk
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/posts/{{ post.id }}.html"
eleventyExcludeFromCollections: true
---
{# Same trail as talks/articles/varia: listing → this page. Without it a post
   was the one detail type that left readers with only the sticky header. #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb__list" vocab="https://schema.org/" typeof="BreadcrumbList">
    <li property="itemListElement" typeof="ListItem">
      <a property="item" href="/posts.html" typeof="WebPage"><span property="name">Posts</span></a>
      <meta property="position" content="1" />
    </li>
    <li><span aria-hidden="true">/</span></li>
    <li property="itemListElement" typeof="ListItem">
      <span property="item" typeof="WebPage" resource="{{ site.url }}{{ page.url }}"><span property="name">{{ post.data.title }}</span></span>
      <meta property="position" content="2" />
    </li>
  </ol>
</nav>

{# `post--wide`: the body takes the full container rather than the 66ch reading
   measure. A post is a page of its own here, and a page that stops two thirds
   of the way across reads as an accident. #}
<article class="post post--wide" vocab="https://schema.org/" typeof="{{ post.data.rdfaType }}"
  resource="{{ site.url }}{{ page.url }}">
  <header class="post-header">
    <h1 property="headline name" class="p-name">{{ post.data.title }}</h1>

    <div class="post-header__meta">
      {% authorList post.data.authors, "post" %}

      <time property="datePublished" datatype="xsd:date" datetime="{{ post.data.pubDate | readableDate }}">{{ post.data.pubDate | readableDate }}</time>
      {% if post.data.updatedDate %}<meta property="dateModified" datatype="xsd:date" content="{{ post.data.updatedDate | readableDate }}" />{% endif %}

      {# Icon and value, like the article footer: "DOI" on its own tells a
         reader nothing they did not already know from the icon. #}
      {% if post.data.doi %}<span><a rel="sameAs" href="https://doi.org/{{ post.data.doi }}" property="identifier" typeof="PropertyValue" title="DOI {{ post.data.doi }}">{% registryIcon 'doi' %}<span class="identifier">{{ post.data.doi }}</span></a></span>{% endif %}

      {% if post.data.pdf %}<span><a href="{{ post.data.pdf }}" rel="alternate noopener" type="application/pdf" target="_blank" title="PDF of {{ post.data.title }}">{% registryIcon 'pdf' %}PDF<span class="visually-hidden"> of {{ post.data.title }} (opens in a new tab)</span></a></span>{% endif %}
    </div>

    {% if post.data.tags.length %}
    <ul class="tag-list" property="keywords" aria-label="Tags">
      {% for tag in post.data.tags %}<li rel="tag" typeof="DefinedTerm"><span class="tag">{{ tag }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="prose post-body" property="articleBody">{{ post.body | renderMarkdown(post.data) | safe }}</div>

  {# Comments live on GitHub Discussions. Embedding them means giscus, which is a
     third-party script on every post and would make this the one page on the
     site that needs JavaScript to be read properly. So there is no embed: a
     single link, scoped to this post's discussion by searching for its title,
     and nothing that has to load or execute. #}
  {% if site.discussionsRepo %}
  <aside class="comments">
    <a class="comments__link" href="https://github.com/{{ site.discussionsRepo }}/discussions?discussions_q={{ post.data.title | urlencode }}" rel="noopener">Discuss this post on GitHub</a>
  </aside>
  {% endif %}

  {% if post.data.license %}
  <footer class="post-license">
    <link rel="license" href="{{ post.data.license.url }}">
    <p>Licensed under <a href="{{ post.data.license.url }}" rel="license">{{ post.data.license.name }}</a>.</p>
  </footer>
  {% endif %}
</article>
